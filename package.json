{
  "name": "@tunnelde/plugin-sdk",
  "version": "1.0.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tunnelde-plugin": "bin/plugin.mjs"
  },
  "exports": {
    "./*": "./sdk/*",
    "./validate": "./scripts/validate.mjs",
    "./archive": "./scripts/plugins/package.mjs",
    "./tools": "./tools/plugin.mjs"
  },
  "files": [
    "sdk",
    "scripts",
    "tools",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check tools/plugin.mjs",
    "verify": "npm run check && npm test",
    "sdk:sync": "node scripts/sync-sdk.mjs",
    "sdk:check": "node scripts/sync-sdk.mjs --check",
    "build": "node --check tools/plugin.mjs",
    "package": "node tools/pack-sdk.mjs",
    "publish:release": "node bin/plugin.mjs publish"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
